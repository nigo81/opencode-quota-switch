{
  "name": "opencode-quota-switch",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin — sidebar quota panel that follows the active provider (GLM / MiniMax / Kimi / DeepSeek)",
  "type": "module",
  "main": "dist/tui.js",
  "exports": {
    "./tui": {
      "import": "./dist/tui.js",
      "config": {
        "enabled": true
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "quota",
    "usage",
    "zhipu",
    "glm",
    "minimax",
    "kimi",
    "deepseek"
  ],
  "license": "MIT",
  "engines": {
    "opencode": ">=1.17.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@opencode-ai/plugin": "1.15.10",
    "@opentui/solid": "0.2.15",
    "esbuild": "^0.25.12",
    "esbuild-plugin-solid": "^0.5.0",
    "solid-js": "1.9.12",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "build:tui": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
}
